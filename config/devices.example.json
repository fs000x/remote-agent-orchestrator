{
  "settings": {
    "transportMode": "auto",
    "runsDir": "runs"
  },
  "devices": [
    {
      "id": "my-linux-box",
      "host": "example.com",
      "port": 22,
      "user": "your-user",
      "workspace": "/home/your-user/your-project",
      "rdaDir": "/home/your-user/.rao/runtime",
      "maxConcurrentGoals": 2,
      "auth": {
        "type": "password",
        "password": "YOUR_PASSWORD (recommended: store in OS keyring via `rao devices add`, then remove this field)"
      }
    }
  ]
}
